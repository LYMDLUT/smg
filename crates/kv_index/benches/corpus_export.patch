+/// Provenance recorded in an exported corpus header.
+pub(crate) struct CorpusExportInfo {
+    pub(crate) trace_path: String,
+    pub(crate) trace_duplication_factor: u64,
+    pub(crate) trace_length_factor: u64,
+    pub(crate) inference_worker_duplication_factor: u64,
+}
+
+/// Write the prepared corpus (after duplication, deadline sort and id assignment, before
+/// lane assignment) in the SMG Mooncake corpus format, so another harness can replay the exact
+/// schedule. The format is documented in smg-project/smg `crates/kv_index/benches/README.md`.
+pub(crate) fn export_corpus(
+    corpus: &PreparedMooncakeCorpus,
+    info: &CorpusExportInfo,
+    path: &str,
+) -> anyhow::Result<()> {
+    use std::io::Write;
+    let mut out = std::io::BufWriter::new(std::fs::File::create(path)?);
+    let mut block_slab: Vec<(u64, u64)> = Vec::new();
+    let mut removed_slab: Vec<u64> = Vec::new();
+    // Pass 1: slabs for event payloads, in operation order.
+    let mut event_slab_offsets = Vec::with_capacity(corpus.operations.len());
+    for operation in &corpus.operations {
+        let offsets = match &operation.payload {
+            MooncakeOperationPayload::Query => (0u64, 0u32),
+            MooncakeOperationPayload::Event(event) => match &event.event.data {
+                KvCacheEventData::Stored(store) => {
+                    let start = block_slab.len() as u64;
+                    for block in &store.blocks {
+                        block_slab.push((block.block_hash.0, block.tokens_hash.0));
+                    }
+                    (start, store.blocks.len() as u32)
+                }
+                KvCacheEventData::Removed(remove) => {
+                    let start = removed_slab.len() as u64;
+                    removed_slab.extend(remove.block_hashes.iter().map(|hash| hash.0));
+                    (start, remove.block_hashes.len() as u32)
+                }
+                KvCacheEventData::Cleared => (0, 0),
+            },
+        };
+        event_slab_offsets.push(offsets);
+    }
+    let logical_workers = corpus
+        .operations
+        .iter()
+        .map(|operation| operation.worker_id)
+        .max()
+        .map_or(0, |worker| worker + 1);
+    let w64 = |out: &mut std::io::BufWriter<std::fs::File>, v: u64| out.write_all(&v.to_le_bytes());
+    let w32 = |out: &mut std::io::BufWriter<std::fs::File>, v: u32| out.write_all(&v.to_le_bytes());
+    out.write_all(b"SMGMCK01")?;
+    w32(&mut out, 1)?;
+    w32(&mut out, corpus.block_size)?;
+    w64(&mut out, corpus.benchmark_duration_ns)?;
+    w64(&mut out, info.trace_duplication_factor)?;
+    w64(&mut out, info.trace_length_factor)?;
+    w64(&mut out, info.inference_worker_duplication_factor)?;
+    w64(&mut out, logical_workers)?;
+    for total in [
+        corpus.totals.requests,
+        corpus.totals.stored_events,
+        corpus.totals.removed_events,
+        corpus.totals.cleared_events,
+        corpus.totals.request_blocks,
+        corpus.totals.stored_blocks,
+        corpus.totals.removed_blocks,
+    ] {
+        w64(&mut out, total as u64)?;
+    }
+    w64(&mut out, info.trace_path.len() as u64)?;
+    out.write_all(info.trace_path.as_bytes())?;
+    w64(&mut out, corpus.query_corpus.hashes.len() as u64)?;
+    for hash in corpus.query_corpus.hashes.iter() {
+        w64(&mut out, hash.0)?;
+    }
+    w64(&mut out, block_slab.len() as u64)?;
+    for (block_hash, tokens_hash) in &block_slab {
+        w64(&mut out, *block_hash)?;
+        w64(&mut out, *tokens_hash)?;
+    }
+    w64(&mut out, removed_slab.len() as u64)?;
+    for hash in &removed_slab {
+        w64(&mut out, *hash)?;
+    }
+    w64(&mut out, corpus.operations.len() as u64)?;
+    for (operation, (slab_start, slab_len)) in corpus.operations.iter().zip(&event_slab_offsets) {
+        w32(&mut out, operation.id)?;
+        w64(&mut out, operation.deadline_ns)?;
+        w64(&mut out, operation.worker_id)?;
+        match &operation.payload {
+            MooncakeOperationPayload::Query => {
+                let spec = corpus.query_corpus.specs[operation.id as usize];
+                anyhow::ensure!(spec.valid, "query {} has no hash range", operation.id);
+                out.write_all(&[0u8])?;
+                w64(&mut out, u64::from(spec.start))?;
+                w32(&mut out, spec.len)?;
+            }
+            MooncakeOperationPayload::Event(event) => {
+                anyhow::ensure!(
+                    event.worker_id == operation.worker_id,
+                    "event {} worker mismatch",
+                    operation.id
+                );
+                match &event.event.data {
+                    KvCacheEventData::Stored(store) => {
+                        out.write_all(&[1u8])?;
+                        w32(&mut out, event.event.dp_rank)?;
+                        w64(&mut out, event.event.event_id)?;
+                        out.write_all(&[u8::from(store.parent_hash.is_some())])?;
+                        w64(&mut out, store.parent_hash.map_or(0, |hash| hash.0))?;
+                        out.write_all(&[u8::from(store.start_position.is_some())])?;
+                        w32(&mut out, store.start_position.unwrap_or(0))?;
+                        w64(&mut out, *slab_start)?;
+                        w32(&mut out, *slab_len)?;
+                    }
+                    KvCacheEventData::Removed(_) => {
+                        out.write_all(&[2u8])?;
+                        w32(&mut out, event.event.dp_rank)?;
+                        w64(&mut out, event.event.event_id)?;
+                        w64(&mut out, *slab_start)?;
+                        w32(&mut out, *slab_len)?;
+                    }
+                    KvCacheEventData::Cleared => {
+                        out.write_all(&[3u8])?;
+                        w32(&mut out, event.event.dp_rank)?;
+                        w64(&mut out, event.event.event_id)?;
+                    }
+                }
+            }
+        }
+    }
+    out.flush()?;
+    Ok(())
+}
