+/// Live-byte and call counters of the process allocator at one moment.
+#[derive(Clone, Copy, Debug, Serialize)]
+pub struct MemorySnapshot {
+    pub live_bytes: usize,
+    pub allocations: u64,
+    pub deallocations: u64,
+    pub reallocations: u64,
+}
+
+/// Memory accounting of one run (feature `memory-accounting`; `None` in the JSON otherwise).
+///
+/// Bytes are what the program requested through `GlobalAlloc` layouts, not the allocator's
+/// internal overhead, so the figure is the same for every allocator.
+#[derive(Clone, Debug, Serialize)]
+pub struct MemoryAccounting {
+    /// After the pre-run quiescence, before the backend exists.
+    pub baseline: MemorySnapshot,
+    /// After the final flush, with the backend holding the end state of the replay.
+    pub after_flush: MemorySnapshot,
+    /// After the backend was dropped (lanes terminated and joined).
+    pub after_indexer_dropped: MemorySnapshot,
+    /// Live bytes freed by dropping the backend: the index, its lanes' per-worker state and
+    /// its queues, nothing of the harness.
+    pub indexer_live_bytes: usize,
+    /// Live bytes at the final flush minus the baseline: the backend plus the harness's own
+    /// run buffers, minus whatever the harness released during the run (it can be negative);
+    /// for cross-checking only.
+    pub live_bytes_delta: i64,
+    pub run_allocations: u64,
+    pub run_deallocations: u64,
+    pub run_reallocations: u64,
+    /// Sum of the backend's per-worker block counts after the final flush.
+    pub resident_blocks_at_end: usize,
+    pub resident_workers_at_end: usize,
+    /// Stored minus removed blocks in the replayed trace, the harness's own count.
+    pub net_stored_blocks: usize,
+    /// `indexer_live_bytes / resident_blocks_at_end`.
+    pub bytes_per_resident_block: f64,
+    /// Strong references to the backend when it was dropped; 1 means the drop freed it.
+    pub indexer_references_at_drop: usize,
+}
+
+impl MemoryAccounting {
+    #[allow(clippy::too_many_arguments)]
+    pub fn new(
+        baseline: MemorySnapshot,
+        after_flush: MemorySnapshot,
+        after_indexer_dropped: MemorySnapshot,
+        resident_blocks_at_end: usize,
+        resident_workers_at_end: usize,
+        net_stored_blocks: usize,
+        indexer_references_at_drop: usize,
+    ) -> Self {
+        let indexer_live_bytes = after_flush
+            .live_bytes
+            .saturating_sub(after_indexer_dropped.live_bytes);
+        Self {
+            baseline,
+            after_flush,
+            after_indexer_dropped,
+            indexer_live_bytes,
+            live_bytes_delta: after_flush.live_bytes as i64 - baseline.live_bytes as i64,
+            run_allocations: after_flush.allocations.saturating_sub(baseline.allocations),
+            run_deallocations: after_flush.deallocations.saturating_sub(baseline.deallocations),
+            run_reallocations: after_flush.reallocations.saturating_sub(baseline.reallocations),
+            resident_blocks_at_end,
+            resident_workers_at_end,
+            net_stored_blocks,
+            bytes_per_resident_block: if resident_blocks_at_end == 0 {
+                0.0
+            } else {
+                indexer_live_bytes as f64 / resident_blocks_at_end as f64
+            },
+            indexer_references_at_drop,
+        }
+    }
+}
+
+/// The counting allocator and the snapshots the open-loop run takes with it
+/// (feature `memory-accounting`). Shared counters: never enabled for timing runs.
+#[cfg(feature = "memory-accounting")]
+pub mod memory_accounting {
+    use std::alloc::{GlobalAlloc, Layout};
+    use std::sync::Mutex;
+    use std::sync::atomic::{AtomicU64, AtomicUsize, Ordering};
+
+    use super::MemorySnapshot;
+
+    static LIVE_BYTES: AtomicUsize = AtomicUsize::new(0);
+    static ALLOCATIONS: AtomicU64 = AtomicU64::new(0);
+    static DEALLOCATIONS: AtomicU64 = AtomicU64::new(0);
+    static REALLOCATIONS: AtomicU64 = AtomicU64::new(0);
+    static BASELINE: Mutex<Option<MemorySnapshot>> = Mutex::new(None);
+
+    /// The process allocator behind live-byte and call counters.
+    pub struct Counting<A>(pub A);
+
+    unsafe impl<A: GlobalAlloc> GlobalAlloc for Counting<A> {
+        unsafe fn alloc(&self, layout: Layout) -> *mut u8 {
+            let pointer = unsafe { self.0.alloc(layout) };
+            if !pointer.is_null() {
+                LIVE_BYTES.fetch_add(layout.size(), Ordering::Relaxed);
+                ALLOCATIONS.fetch_add(1, Ordering::Relaxed);
+            }
+            pointer
+        }
+
+        unsafe fn alloc_zeroed(&self, layout: Layout) -> *mut u8 {
+            let pointer = unsafe { self.0.alloc_zeroed(layout) };
+            if !pointer.is_null() {
+                LIVE_BYTES.fetch_add(layout.size(), Ordering::Relaxed);
+                ALLOCATIONS.fetch_add(1, Ordering::Relaxed);
+            }
+            pointer
+        }
+
+        unsafe fn dealloc(&self, pointer: *mut u8, layout: Layout) {
+            unsafe { self.0.dealloc(pointer, layout) };
+            LIVE_BYTES.fetch_sub(layout.size(), Ordering::Relaxed);
+            DEALLOCATIONS.fetch_add(1, Ordering::Relaxed);
+        }
+
+        unsafe fn realloc(&self, pointer: *mut u8, layout: Layout, new_size: usize) -> *mut u8 {
+            let moved = unsafe { self.0.realloc(pointer, layout, new_size) };
+            if !moved.is_null() {
+                LIVE_BYTES.fetch_add(new_size, Ordering::Relaxed);
+                LIVE_BYTES.fetch_sub(layout.size(), Ordering::Relaxed);
+                REALLOCATIONS.fetch_add(1, Ordering::Relaxed);
+            }
+            moved
+        }
+    }
+
+    /// The counters now.
+    pub fn snapshot() -> MemorySnapshot {
+        MemorySnapshot {
+            live_bytes: LIVE_BYTES.load(Ordering::Relaxed),
+            allocations: ALLOCATIONS.load(Ordering::Relaxed),
+            deallocations: DEALLOCATIONS.load(Ordering::Relaxed),
+            reallocations: REALLOCATIONS.load(Ordering::Relaxed),
+        }
+    }
+
+    /// Record the baseline: called after the pre-run quiescence, before the backend exists.
+    pub fn mark_baseline() {
+        *BASELINE.lock().unwrap_or_else(|poisoned| poisoned.into_inner()) = Some(snapshot());
+    }
+
+    /// The recorded baseline, if any.
+    pub fn baseline() -> Option<MemorySnapshot> {
+        *BASELINE.lock().unwrap_or_else(|poisoned| poisoned.into_inner())
+    }
+}
